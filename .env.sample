# --- Database (local SQLite by default; no external service needed) ---
DATABASE_URL=file:./prisma/dev.db

# --- Deploy engine ---
# Leave unset/false to run the simulated engine (fake builds + logs). Public deploys
# of this app should keep this OFF so visitors never trigger real sandboxes.
ENABLE_REAL_SANDBOX=false

# --- Real Vercel Sandbox deploys (only when ENABLE_REAL_SANDBOX=true) ---
# Easiest locally: run `vercel link` then `vercel env pull .env.local` to get a
# short-lived VERCEL_OIDC_TOKEN — then you can leave the three below blank.
# Otherwise provide a token + ids explicitly:
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
