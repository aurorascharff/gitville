# Optional but strongly recommended: raises GitHub's API limit from 60 to 5000 req/hr.
# Server-side reads are cached (use cache: remote), so all visitors share one upstream
# fetch per ~45s window per repo — a classic fine-grained PAT with public repo read
# access is plenty. Add this on Vercel too.
GITHUB_TOKEN=

# Optional: pins same-origin server-action checks when self-hosting or sitting
# behind a custom proxy. Example: https://gitville.vercel.app
APP_ORIGIN=
