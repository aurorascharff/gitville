# --- Database (Postgres; Neon in production) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Real Vercel Sandbox deploys ---
# Real deploys run ONLY in local development (NODE_ENV !== 'production'); the public
# deployment always runs the simulated engine so visitors can never use your compute.
# To enable real deploys locally, set this and provide credentials below.
ENABLE_REAL_SANDBOX=false

# Easiest locally: `vercel link` then `vercel env pull .env.local` to get VERCEL_OIDC_TOKEN
# (then leave the three below blank). Otherwise provide a token + ids explicitly:
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
